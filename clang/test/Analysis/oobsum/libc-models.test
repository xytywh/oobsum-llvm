# 内置模型补上 libc 的 strncpy / snprintf / vsnprintf（oobsum/specs/SPEC-0065；06- F-05）。
#
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:ReportSafe=true \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:Dump=models %S/Inputs/libc/l.c 2>&1 | FileCheck %s

CHECK-DAG: [oobsum:models] access strncpy W p0[p2] R p1[<=p2]
CHECK-DAG: [oobsum:models] access snprintf W p0[<=p1]
CHECK-DAG: [oobsum:models] access vsnprintf W p0[<=p1]
# strncpy 补满 n 字节：n 超过目的大小 → DEFINITE；n 在界内 → SAFE
CHECK-DAG: l.c:9:1: warning: [OOB-DEFINITE] Definite out-of-bound write through a 1-level call chain: up to byte 32 of 'b' (8 bytes) is accessed
CHECK-DAG: l.c:10:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 8 of 'b' (8 bytes)
# snprintf 最多写 n 字节 → POSSIBLE；n 在界内 → SAFE
CHECK-DAG: l.c:11:1: warning: [OOB-POSSIBLE] Possible out-of-bound write through a 1-level call chain: up to byte 32 of 'b' (8 bytes) may be accessed; the bound comes from a size argument of a library function
CHECK-DAG: l.c:12:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 8 of 'b' (8 bytes)
# 对照：strcpy 照旧
CHECK-DAG: l.c:14:1: warning: [OOB-SUSPECT:not_in_tu] Cannot prove this access is within bounds: a pointer is passed to 'strcpy'
