# 成员数组当实参（oobsum/specs/SPEC-0035）：调用点记录带外层对象（parent），代换时成员证明了安全还要查外层。
#
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:ReportSafe=true \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:Dump=summary+stats -analyzer-config 'rb.enhance.ipa.OobSummary:DumpFilter=Msg_Clear$' \
# RUN:   %S/Inputs/member/member_arg.c 2>&1 | FileCheck %s

CHECK: [oobsum:summary] {"calls":[{"args":[{"have":"1024","obj":"p0->aucBody","parent":{"have":"ext(p0) - 4","obj":"*p0"}},"512"]
CHECK: [oobsum:stats] tu={{[0-9a-f]+}} decisions=7 emitted=6
# 64 字节的缓冲区当成 MSG：成员 512 <= 1024 成立，外层 512 <= 64 - 4 不成立（原来这里是错误的 SAFE）
CHECK-DAG: member_arg.c:23:1: warning: [OOB-DEFINITE] Definite out-of-bound write through a 2-level call chain: up to byte 512 of 'auc' (60 bytes) is accessed
CHECK-DAG: member_arg.c:29:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 512 of 'st' (1024 bytes)
# 同样的访问写在函数里（SPEC-0022）
CHECK-DAG: member_arg.c:40:1: warning: [OOB-DEFINITE] Definite out-of-bound write through a 1-level call chain: up to byte 516 of 'auc' (64 bytes) is accessed
# 成员本身就越界：只按成员报一次
CHECK-DAG: member_arg.c:45:1: warning: [OOB-DEFINITE] Definite out-of-bound write through a 1-level call chain: up to byte 2048 of 'pstMsg->aucBody' (1024 bytes) is accessed
CHECK-NOT: member_arg.c:45:1: warning: [OOB-
# 入口 Entry_Msg：成员、外层两条账本只报一条（SPEC-0036）
CHECK: member_arg.c:55:1: warning: [OOB-SUSPECT:type_range_only] Cannot prove the write through a 1-level call chain stays within 'pstMsg->aucBody'
CHECK-NOT: member_arg.c:55:1: warning: [OOB-

# 判定日志里两条都在：外层那条 dup_of 指向报出的那条，不报的原因 duplicate_access；第一条被 SuspectReasons 滤掉时外层那条照常报
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:Dump=decisions \
# RUN:   %S/Inputs/member/member_arg.c 2>&1 | grep 'Entry_Msg' | FileCheck %s --check-prefix=DUP
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:SuspectReasons=entry_unproven \
# RUN:   %S/Inputs/member/member_arg.c 2>&1 | FileCheck %s --check-prefix=PICKY
DUP: [oobsum:decisions] {{.*}}"emitted":true,"end":{{.*}}"fp":"[[FP:[0-9a-f]+]]"{{.*}}"obj":"p0->aucBody"{{.*}}"reason":"type_range_only"
DUP: [oobsum:decisions] {"bound":{{.*}}"dup_of":"[[FP]]","eff_depth":0,"emitted":false,{{.*}}"not_emitted_because":"duplicate_access","obj":"*p0"{{.*}}"reason":"entry_unproven"
PICKY: member_arg.c:55:1: warning: [OOB-SUSPECT:entry_unproven] Cannot prove the write through a 1-level call chain stays within '*pstMsg'
