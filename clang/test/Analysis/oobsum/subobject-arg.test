# 带窗口的实参（oobsum/specs/SPEC-0104 §2.3 3b，用户决定 D22）：把指向成员数组 / 二维数组一行的指针交给被调者，调用点另记内层剩余（sub），
# 被调者的 Req 在外层 safe / up 时按内层剩余再判一次：越出内层 → SUSPECT subobject_overflow；外层已经报的不再加内层这条。
#
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:ReportSafe=true \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:Dump=summary+apply -analyzer-config 'rb.enhance.ipa.OobSummary:DumpFilter=^(Arg_Tp|Row_Tp)$' \
# RUN:   -w %S/Inputs/subobj/a.c 2>&1 | FileCheck %s

# 实参：st.aucBuf 外层剩 28、内层剩 16；a[0] 外层剩 8、内层剩 4
CHECK-DAG: [oobsum:summary] {{.*}}"args":[{"back":"4","have":"28","obj":"local:st","sub":"16","sub_back":"0"},"20"]
CHECK-DAG: [oobsum:summary] {{.*}}"args":[{"back":"0","have":"8","obj":"local:a","sub":"4"},"5"]
CHECK-DAG: [oobsum:apply] Arg_Tp @ a.c:7 Fill.a.c:5 → open (subobject_overflow) [sub]
# Fill(st.aucBuf, 20)：没越出 st、越出 aucBuf
CHECK-DAG: a.c:7:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 20 of 'st' (28 bytes)
CHECK-DAG: a.c:7:1: warning: [OOB-SUSPECT:subobject_overflow] Cannot prove the write through a 1-level call chain stays within the array member or row (16 bytes) of 'st': up to byte 20 of it may be accessed
CHECK-DAG: a.c:8:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 16 of 'st' (28 bytes)
# 外层已经报（POSSIBLE）：不再加内层
CHECK-DAG: a.c:9:1: warning: [OOB-POSSIBLE] Possible out-of-bound write through a 1-level call chain: up to byte 40 of 'st' (28 bytes) may be accessed
# 二维数组的一行
CHECK-DAG: a.c:10:1: warning: [OOB-SUSPECT:subobject_overflow] Cannot prove the write through a 1-level call chain stays within the array member or row (4 bytes) of 'a': up to byte 5 of it may be accessed
# 经中间函数：Mid 的 Req 原样上传，在 Mid_Tp 的调用点按内层判
CHECK-DAG: a.c:11:1: warning: [OOB-SUSPECT:subobject_overflow] Cannot prove the write through a 2-level call chain stays within the array member or row (16 bytes) of 'st': up to byte 20 of it may be accessed
CHECK-DAG: a.c:12:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 16 of 'st' (28 bytes)
CHECK-NOT: a.c:{{(8|9|12)}}:1: warning: [OOB-SUSPECT:subobject_overflow]
