# 汇合时按各自路上的守卫求常数界（oobsum/specs/SPEC-0042）：if (i > 15) i = 15; 这类钳位不再丢界。
#
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:ReportSafe=true \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:Dump=state -analyzer-config 'rb.enhance.ipa.OobSummary:DumpFilter=^Clamp$' \
# RUN:   %S/Inputs/clamp/clamp.c 2>&1 | FileCheck %s

# 汇合后的区间（Dump=state）：两条路分别是 i <= 15 与常数 15
CHECK: [oobsum:state] fn Clamp b1: p=*p0+0 i=[0, 15]:check
CHECK-DAG: clamp.c:7:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 16 of 'a' (16 bytes)
CHECK-DAG: clamp.c:10:1: warning: [OOB-POSSIBLE] Possible out-of-bound write through a 1-level call chain: up to byte 17 of 'a' (16 bytes) may be accessed; the bound comes from a check
CHECK-DAG: clamp.c:13:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 8 of 'a' (16 bytes)
# 对照：钳到 20 仍报
CHECK-DAG: clamp.c:17:1: warning: [OOB-POSSIBLE] Possible out-of-bound write through a 1-level call chain: up to byte 21 of 'a' (16 bytes) may be accessed; the bound comes from a check
