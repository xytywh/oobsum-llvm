# S9.1：只被赋过函数地址常量的局部函数指针当直接调用；多个目标时每个目标一条 alt 调用点记录、只判 POSSIBLE（oobsum/specs/SPEC-0058；06- A-60 ①）。
#
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 -analyzer-config rb.enhance.ipa.OobSummary:ReportSafe=true \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:Dump=summary -analyzer-config 'rb.enhance.ipa.OobSummary:DumpFilter=^(Dispatch|One)$' \
# RUN:   %S/Inputs/fptr/local.c 2>&1 | FileCheck %s
# 解析出的调用点不再记 fptr
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.ipa.OobSummary \
# RUN:   -analyzer-config rb.enhance.ipa.OobSummary:InlineDepth=0 %S/Inputs/fptr/local.c 2>&1 | not grep -E 'local.c:1[16]:1: warning: \[OOB-SUSPECT:fptr'

# 两个目标：两条 alt 调用点记录
CHECK-DAG: [oobsum:summary] {"calls":[{"alt":true,{{.*}}"callee":"Lte_Save",{{.*}}"ind":true,{{.*}}"site":"local.c:11"},{"alt":true,{{.*}}"callee":"Nr_Save",{{.*}}"ind":true,{{.*}}"site":"local.c:11"}],{{.*}}"fn":"Dispatch"
# 一个目标：当直接调用（带 ind）
CHECK-DAG: [oobsum:summary] {"calls":[{"args":{{.*}}"callee":"Nr_Save",{{.*}}"ind":true,{{.*}}"site":"local.c:16"}],{{.*}}"fn":"One"
CHECK-DAG: local.c:12:1: warning: [OOB-POSSIBLE] Possible out-of-bound write through a 2-level call chain: up to byte 17 of 'a' (16 bytes) may be accessed; the bound comes from the call arguments
CHECK-DAG: local.c:13:1: warning: [OOB-SAFE:within] Proven within bounds: up to byte 16 of 'a' (16 bytes)
CHECK-DAG: local.c:17:1: warning: [OOB-DEFINITE] Definite out-of-bound write through a 2-level call chain: up to byte 17 of 'a' (16 bytes) is accessed
# 对照：形参函数指针照旧 fptr
CHECK-DAG: local.c:20:1: warning: [OOB-SUSPECT:fptr] Cannot prove this access is within bounds: a pointer is passed through a function pointer whose target is not resolved
