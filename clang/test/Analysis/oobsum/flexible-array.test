# SPEC-0127：默认策略过滤、开关恢复报告；固定数组与固定内层界仍然报告。
# RUN: rm -rf %t
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.core.OobSummary -analyzer-config rb.enhance.core.OobSummary:WorkDir=%t/default -analyzer-config rb.enhance.core.OobSummary:Dump=fir+summary+state %S/Inputs/flexible/f.c > %t.default.log 2>&1
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.core.OobSummary -analyzer-config rb.enhance.core.OobSummary:WorkDir=%t/report -analyzer-config rb.enhance.core.OobSummary:ReportFlexibleArray=true %S/Inputs/flexible/f.c > %t.report.log 2>&1
# RUN: %clang_analyze_cc1 -triple armebv7-linux-gnueabi -fno-signed-char -analyzer-checker=rb.enhance.core.OobSummary -analyzer-config rb.enhance.core.OobSummary:WorkDir=%t/zero -analyzer-config rb.enhance.core.OobSummary:FlexibleArrayMax=0 %S/Inputs/flexible/f.c > %t.zero.log 2>&1
# RUN: %python %S/Inputs/flexible/check.py %t
