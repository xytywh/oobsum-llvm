# 跨 TU 的驱动（oobsum/specs/SPEC-0031）：local 跑三阶段、status、bxen 生成桩 cdb 与 report cdb、打印三段命令。
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/../../../../oobsum/tools/oobsum_run.py local --workdir %t/w --clang %clang --config InlineDepth=0 \
# RUN:   %S/Inputs/solve/a.c %S/Inputs/solve/b.c | FileCheck %s --check-prefix=LOCAL
# RUN: %python %S/../../../../oobsum/tools/oobsum_run.py status --workdir %t/w | FileCheck %s --check-prefix=STATUS
# bxen：用一个假的原 cdb（含 a.c、b.c 与一个没有判定的文件）
# RUN: mkdir -p %t/cdb
# RUN: %python -c "import json,sys; d='%S/Inputs/solve'; json.dump([{'directory': d, 'file': f, 'arguments': ['cc', '-c', f]} for f in ['a.c', 'b.c', 'stub.c']], open('%t/cdb/compile_commands.json', 'w'))"
# RUN: %python %S/../../../../oobsum/tools/oobsum_run.py bxen --workdir %t/w --bxen /usr1/bxen --cc-json %t/cdb | FileCheck %s --check-prefix=BXEN
# RUN: %python -c "import json; print(len(json.load(open('%t/w/report_cdb/compile_commands.json'))))" | FileCheck %s --check-prefix=RCDB

LOCAL: $ {{.*}}Phase=export{{.*}}a.c
LOCAL: $ {{.*}}Phase=solve{{.*}}solve_stub/stub.c
LOCAL: $ {{.*}}Phase=report
LOCAL: export 2 个 TU；solve 判定 4 条；report 2 个 TU，告警 3 条

STATUS: fir/ 2 个；solved/ 2 个（判定不为空 2 个）；decisions/ 2 个
STATUS: report：2 条命令
STATUS: 下一步：完成

BXEN: # report 的 cdb：2 个 TU（原 cdb 3 个）
BXEN: $ /usr1/bxen -exec_mode=onlySa -cc_json={{.*}}cdb -checker=rb.enhance.ipa.OobSummary '-extra_args=-analyzer-config rb.enhance.ipa.OobSummary:Phase=export
BXEN: $ /usr1/bxen -exec_mode=onlySa -cc_json={{.*}}solve_stub -analysis_file={{.*}}stub.c {{.*}}Phase=solve
BXEN: $ /usr1/bxen -exec_mode=onlySa -cc_json={{.*}}report_cdb {{.*}}Phase=report

RCDB: 2
